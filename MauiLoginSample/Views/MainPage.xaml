<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="MauiLoginSample.Views.MainPage" x:DataType="viewmodel:MainViewModel"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:MauiLoginSample.Helpers"
             xmlns:local="clr-namespace:MauiLoginSample.MarkupExtensions"
             xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:model="clr-namespace:MauiLoginSample.Models"
             xmlns:sys="clr-namespace:System;assembly=netstandard"
             xmlns:viewmodel="clr-namespace:MauiLoginSample.ViewModels"
             Title="{Binding Title}">

    <ContentPage.Resources>
        <Style x:Key="rectBox" TargetType="BoxView">
            <Setter Property="WidthRequest" Value="80" />
            <Setter Property="HeightRequest" Value="80" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <Grid x:Name="parentGrid" RowDefinitions="Auto,Auto,Auto,*">

            <Image x:Name="topImage" Grid.Row="0" Aspect="AspectFit"
                   HeightRequest="150" Source="banner_bg.jpg" />

            <!--<Label Grid.Row="0" Text="{Binding Source={Reference parentGrid}, Path=Width, StringFormat='Width of Parent Grid: {0}'}" />
            <Label Grid.Row="1" Text="{Binding Source={RelativeSource AncestorType={x:Type Grid}, AncestorLevel=0}, Path=Width, StringFormat='Self Width of Parent Grid: {0}'}" />-->

            <BoxView Grid.Row="0"
                     BackgroundColor="{StaticResource Primary}"
                     HeightRequest="150" HorizontalOptions="Fill" Opacity="0.7"
                     VerticalOptions="Fill" />

            <Border Grid.Row="1" Margin="0,-50,0,0"
                    BackgroundColor="{StaticResource Gray100}"
                    HorizontalOptions="Center" StrokeShape="RoundRectangle 80" StrokeThickness="6"
                    VerticalOptions="Center">

                <Image Aspect="AspectFit" HeightRequest="100" HorizontalOptions="Center"
                       Source="dotnet_bot.png" VerticalOptions="Center" WidthRequest="100" />

                <Border.Stroke>
                    <LinearGradientBrush EndPoint="0,1">
                        <GradientStop Offset="0.1" Color="{StaticResource Primary}" />
                        <GradientStop Offset="1.0" Color="{StaticResource Secondary}" />
                    </LinearGradientBrush>
                </Border.Stroke>
            </Border>

            <VerticalStackLayout Grid.Row="3" Padding="10" HorizontalOptions="Center" Spacing="10">

                <Grid BackgroundColor="AntiqueWhite" ColumnDefinitions="Auto,*" ColumnSpacing="10" HorizontalOptions="FillAndExpand">
                    <Label FontAttributes="Bold" Text="Hue:" VerticalOptions="Center" />
                    <Slider x:Name="slider" Grid.Column="1" HorizontalOptions="FillAndExpand"
                            Maximum="1" Minimum="0" />
                </Grid>

                <Label Text="User Name" VerticalOptions="FillAndExpand" VerticalTextAlignment="Center" />

                <Entry x:Name="userName" Keyboard="Default" MaxLength="20"
                       Placeholder="Enter your user name"
                       Text="{Binding UserName}"
                       VerticalOptions="FillAndExpand" />

                <Label Text="Password" VerticalOptions="FillAndExpand" VerticalTextAlignment="Center" />

                <Entry x:Name="userPassword" IsPassword="True" Keyboard="Default"
                       MaxLength="20" Placeholder="Enter your password"
                       Text="{Binding Password}"
                       VerticalOptions="FillAndExpand" />

                <Button Margin="8"
                        Command="{Binding SignInCommand}"
                        HorizontalOptions="Center"
                        IsEnabled="{Binding EnableSignInButton}"
                        Text="Sign In" WidthRequest="200">
                    <!--<Button.IsEnabled>
                        <MultiBinding Converter="{mct:VariableMultiValueConverter ConditionType=All}">
                            <Binding Converter="{mct:IntToBoolConverter}" Path="Text.Length" Source="{x:Reference userName}" />
                            <Binding Converter="{mct:IntToBoolConverter}" Path="Text.Length" Source="{x:Reference userPassword}" />
                        </MultiBinding>
                    </Button.IsEnabled>-->
                </Button>

                <Button Margin="8" BackgroundColor="White"
                        Command="{Binding CreateNewCommand}"
                        HorizontalOptions="Center"
                        Style="{StaticResource ButtonOutline}"
                        Text="New User? Create Account"
                        TextColor="{StaticResource Gray600}" />

                <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                    <BoxView Style="{StaticResource rectBox}">
                        <BoxView.Color>
                            <local:HslColorExtensionSingle A="1" H="{Binding Source={x:Reference slider}, Path=Value}" L="0.5" S="1" />
                        </BoxView.Color>
                    </BoxView>

                    <BoxView Style="{StaticResource rectBox}" Color="{local:HslColorExtensionSingle S='0.5', A='1', H={Binding Source={x:Reference slider}, Path=Value}, L='0.5'}" />
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </Grid>
    </ScrollView>

</ContentPage>
